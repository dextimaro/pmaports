# Reference: <https://postmarketos.org/vendorkernel>
# r23 stability candidate for Xiaomi Redmi 9A (dandelion, M2007C3LG).
pkgname=linux-xiaomi-dandelion
pkgver=4.19.248
pkgrel=1
pkgdesc="Xiaomi Redmi 9A Niigo downstream kernel"
arch="aarch64"
_carch="arm64"
_flavor="xiaomi-dandelion"
url="https://github.com/TelegramAt25/niigo_kernel_xiaomi_blossom"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	devicepkg-dev
	findutils
	flex
	gcompat
	linux-headers
	openssl-dev
	perl
	python3
	tzdata
"

_commit="31abca52e78ab59011e4e1711a7995ff1f34a178"
_clang_commit="252aba16f513a857bc923172f67b0e55e23de35f"
_config="config-$_flavor.$arch"
_config_sha256="09ee900979a22e5192e2f974d83f0b34f964dbad1ba381841fe86f5deac084bb"
_outdir="out"
_toolchain="$srcdir"

source="
	$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz
	clang-r383902b.tar.gz::https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/$_clang_commit/clang-r383902b.tar.gz
	$_config
	dandelion-twrp.dtb
	0001-power-supply-add-SGM41513-charger-support.patch
	0002-power-allow-SGM41513-safe-module-testing.patch
	0003-power-sgm41513-allow-operation-without-IRQ-GPIO.patch
	0004-kernel-fix-public-niigo-source-build-errors.patch
	0005-mrdump-provide-missing-public-tree-watchdog-stub.patch
	0006-gps-keep-disabled-connsys-log-path-consistent.patch
	0007-soc-mediatek-include-sched_clock-declaration.patch
	0008-ikconfig-embed-active-build-config.patch
"
builddir="$srcdir/niigo_kernel_xiaomi_blossom-$_commit"

_kernel_make() {
	TZ=Europe/Moscow PATH="$_toolchain/bin:$PATH" make -C "$builddir" \
		O="$_outdir" \
		ARCH="$_carch" \
		CC="$_toolchain/bin/clang" \
		LD="$_toolchain/bin/ld.lld" \
		AR="$_toolchain/bin/llvm-ar" \
		NM="$_toolchain/bin/llvm-nm" \
		OBJCOPY="$_toolchain/bin/llvm-objcopy" \
		OBJDUMP="$_toolchain/bin/llvm-objdump" \
		STRIP="$_toolchain/bin/llvm-strip" \
		HOSTCC=gcc \
		HOSTCXX=g++ \
		CLANG_TRIPLE=aarch64-linux-gnu- \
		CROSS_COMPILE="${CROSS_COMPILE:-aarch64-alpine-linux-musl-}" \
		KCFLAGS="-Wno-error=unused-variable" \
		KBUILD_BUILD_USER=postmarketos \
		KBUILD_BUILD_HOST=dandelion \
	KBUILD_BUILD_VERSION=5 \
		KBUILD_BUILD_TIMESTAMP="@1787665295" \
		"$@"
}

prepare() {
	default_prepare
	mkdir -p "$builddir/$_outdir"
	cp "$srcdir/$_config" "$builddir/$_outdir/.config"
	_kernel_make olddefconfig
	actual_config_sha256="$(sha256sum "$builddir/$_outdir/.config" | cut -d' ' -f1)"
	if [ "$actual_config_sha256" != "$_config_sha256" ]; then
		echo "r23 config changed after olddefconfig: $actual_config_sha256" >&2
		return 1
	fi

	# Refuse to silently build r17, r18 or the failed SR9700 experiment (r20).
	grep -qx 'CONFIG_USB_NET_DM9601=y' "$builddir/$_outdir/.config"
	grep -qx '# CONFIG_USB_NET_SR9700 is not set' "$builddir/$_outdir/.config"
	grep -qx 'CONFIG_CHARGER_SGM41513=y' "$builddir/$_outdir/.config"
	grep -qx '# CONFIG_CPU_FREQ_TIMES is not set' "$builddir/$_outdir/.config"
	grep -qx '# CONFIG_VMAP_STACK is not set' "$builddir/$_outdir/.config"
	grep -qx '# CONFIG_FOCALTECH_FINGERPRINT is not set' \
		"$builddir/$_outdir/.config"
}

build() {
	unset LDFLAGS
	_kernel_make Image.gz
}

package() {
	KERNEL_IMAGE_NAME=Image.gz downstreamkernel_package \
		"$builddir" "$pkgdir" "$_carch" "$_flavor" "$_outdir"

	# r19 was tested with the DTB extracted from the stable dandelion TWRP.
	# The public Niigo tree does not emit a matching standalone dandelion DTB.
	install -Dm644 "$srcdir/dandelion-twrp.dtb" \
		"$pkgdir/boot/dtbs/mediatek/dandelion.dtb"
	install -Dm644 "$builddir/$_outdir/.config" \
		"$pkgdir/usr/share/kernel/$_flavor/config"
}

