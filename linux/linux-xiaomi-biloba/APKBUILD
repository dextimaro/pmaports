# Reference: <https://postmarketos.org/vendorkernel>
# Base defconfig: arch/arm64/configs/biloba_defconfig
pkgname=linux-xiaomi-biloba
pkgver=4.14.186
pkgrel=2
pkgdesc="Xiaomi Redmi Note 8 (2021) kernel"
arch="aarch64"
_carch="arm64"
_flavor="xiaomi-biloba"
url="https://github.com/MiCode/Xiaomi_Kernel_OpenSource"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="bash bc bison devicepkg-dev findutils flex openssl-dev perl xz dtc"
_commit="831600317054fb8e980f0b527975a6492d4788fa"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz
	$_config
	disable-embedded-touchscreen-fw-upgrade.patch
	fix-duplicate-mtk-vcodec-mem.patch
	fix-duplicate-set-selection.patch
	fix-trusty-vring-null-race.patch
	fix-typec-power-operation-mode-oob.patch
	selinux_include_generated_headers.patch
	use_system_cpio.patch
	stop-inlining-blk_crypto_flock-and-ksm_flock.patch
	use_system_dtc.patch
"
builddir="$srcdir/Xiaomi_Kernel_OpenSource-$_commit"
_outdir="out"

prepare() {
	default_prepare
	REPLACE_GCCH=0 . downstreamkernel_prepare
}

build() {
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS"
}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"
	make dtbs_install O="$_outdir" ARCH="$_carch" \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
}

