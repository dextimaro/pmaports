# Local downstream kernel package rebuilt from the recorded j1minivelte source.
maintainer=""
pkgname=linux-samsung-j1minivelte
pkgver=3.10.65
pkgrel=1
pkgdesc="Downstream kernel with dual-role USB Ethernet for Samsung SM-J106F"
arch="armv7"
_flavor="samsung-j1minivelte"
url="https://github.com/lasania32198/android_kernel_samsung_j1minivelte"
license="GPL-2.0-only"
options="!strip !check !tracedeps !archcheck"
source="
	kernel
	dt.img
"

package() {
	install -Dm644 "$srcdir/kernel" "$pkgdir/boot/vmlinuz"
	install -Dm644 "$srcdir/dt.img" "$pkgdir/boot/dt.img"
	mkdir -p "$pkgdir/usr/share/kernel/$_flavor"
	printf '%s\n' "$pkgver-$_flavor" > "$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}

sha512sums="
