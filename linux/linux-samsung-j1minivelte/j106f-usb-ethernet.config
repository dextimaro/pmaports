# Enable the SC9830I dual-role controller host path. The stock Samsung
# defconfig intentionally compiles the controller as peripheral-only.
# CONFIG_SPRD_USB_DEVICE_ONLY is not set
CONFIG_USB_OTG=y
# CONFIG_USB_OTG_WHITELIST is not set
# CONFIG_USB_OTG_BLACKLIST_HUB is not set
CONFIG_USB_HOST_NOTIFY=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y

# Build common USB Ethernet drivers into the kernel. There is no matching
# external module package in the minimal postmarketOS rootfs, so modules are
# deliberately avoided.
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8150=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_EEM=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_DM9601=y
CONFIG_USB_NET_SMSC75XX=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_NET_MCS7830=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_CDC_SUBSET=y
CONFIG_USB_NET_ZAURUS=y
