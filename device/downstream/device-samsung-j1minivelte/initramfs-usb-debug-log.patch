--- a/usr/share/initramfs/init.sh
+++ b/usr/share/initramfs/init.sh
@@ -54,0 +55,19 @@
+# Read-only early diagnostics for devices whose rootfs does not reach OpenRC.
+# Opening ttyGS0 for output also activates the legacy Android ACM endpoint.
+(
+	while [ ! -c /dev/ttyGS0 ]; do
+		sleep 1
+	done
+	exec >/dev/ttyGS0 2>&1
+	echo "__J106_INITRAMFS_DIAGNOSTICS__"
+	while true; do
+		echo "--- cmdline ---"
+		cat /proc/cmdline
+		echo "--- partitions ---"
+		cat /proc/partitions
+		echo "--- recent kernel log ---"
+		dmesg | tail -80
+		sleep 10
+	done
+) &
+
