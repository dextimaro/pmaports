#!/bin/sh
set -u

TAG=j106-usb-network
ANDROID_USB=/sys/class/android_usb/android0
HOST_MODE=/sys/class/host_notify/usb_otg/mode
RNDIS_IF=rndis0
UDHCPC_PID=/run/j106-udhcpc.pid
UDHCPD_PID=/run/j106-udhcpd.pid
UDHCPD_CONF=/etc/udhcpd-rndis.conf
POLL_SECONDS=2

log() {
	logger -t "$TAG" -- "$*"
}

alive() {
	[ -s "$1" ] || return 1
	pid=$(cat "$1" 2>/dev/null) || return 1
	kill -0 "$pid" 2>/dev/null
}

stop_pidfile() {
	pidfile=$1
	if alive "$pidfile"; then
		kill "$(cat "$pidfile")" 2>/dev/null || true
	fi
	rm -f "$pidfile"
}

ensure_sshd() {
	if command -v rc-service >/dev/null 2>&1; then
		rc-service sshd status >/dev/null 2>&1 ||
			rc-service sshd start >/dev/null 2>&1 || true
	fi
}

host_mode() {
	if [ -r "$HOST_MODE" ]; then
		tr -d '\r\n' <"$HOST_MODE"
	else
		printf 'UNKNOWN'
	fi
}

usb_ethernet_interface() {
	for netpath in /sys/class/net/*; do
		[ -e "$netpath" ] || continue
		iface=${netpath##*/}
		case "$iface" in
			lo|rndis0|wlan*|p2p*|sit*|ip6tnl*|dummy*) continue ;;
		esac
		device=$(readlink -f "$netpath/device" 2>/dev/null || true)
		case "$device" in
			*/usb*/*) printf '%s\n' "$iface"; return 0 ;;
		esac
	done
	return 1
}

disable_rndis() {
	stop_pidfile "$UDHCPD_PID"
	if [ -d "$ANDROID_USB" ]; then
		echo 0 >"$ANDROID_USB/enable" 2>/dev/null || true
	fi
	ifconfig "$RNDIS_IF" down 2>/dev/null || true
}

configure_rndis_gadget() {
	[ -d "$ANDROID_USB" ] || return 1
	echo 0 >"$ANDROID_USB/enable" 2>/dev/null || true
	echo 0525 >"$ANDROID_USB/idVendor"
	echo a4a2 >"$ANDROID_USB/idProduct"
	echo rndis >"$ANDROID_USB/functions"
	echo 1 >"$ANDROID_USB/enable"

	count=0
	while [ ! -d "/sys/class/net/$RNDIS_IF" ] && [ "$count" -lt 10 ]; do
		count=$((count + 1))
		sleep 1
	done
	[ -d "/sys/class/net/$RNDIS_IF" ] || return 1
	ifconfig "$RNDIS_IF" 172.16.42.1 netmask 255.255.255.0 up
	return 0
}

start_rndis_dhcp() {
	command -v udhcpd >/dev/null 2>&1 || return 0
	[ -f "$UDHCPD_CONF" ] || return 0
	alive "$UDHCPD_PID" && return 0
	mkdir -p /var/lib/misc
	touch /var/lib/misc/udhcpd-rndis.leases
	udhcpd -f "$UDHCPD_CONF" >/dev/null 2>&1 &
	echo $! >"$UDHCPD_PID"
}

start_usb_ethernet_dhcp() {
	iface=$1
	ifconfig "$iface" up 2>/dev/null || true
	alive "$UDHCPC_PID" && return 0
	udhcpc -f -R -p "$UDHCPC_PID" -i "$iface" \
		-x "hostname:j106f" >/dev/null 2>&1 &
	echo $! >"$UDHCPC_PID"
}

cleanup() {
	stop_pidfile "$UDHCPC_PID"
	stop_pidfile "$UDHCPD_PID"
}
trap cleanup EXIT INT TERM

state=
dhcp_iface=
ensure_sshd

while :; do
	mode=$(host_mode)
	iface=$(usb_ethernet_interface 2>/dev/null || true)

	if [ -n "$iface" ]; then
		if [ "$state" != "ethernet:$iface" ]; then
			log "USB Ethernet $iface detected; selecting host networking"
			disable_rndis
			stop_pidfile "$UDHCPC_PID"
			state="ethernet:$iface"
			dhcp_iface=$iface
		fi
		start_usb_ethernet_dhcp "$iface"
		ensure_sshd
	elif [ "$mode" = HOST ]; then
		if [ "$state" != host-wait ]; then
			log "USB host mode active; waiting for a supported Ethernet adapter"
			disable_rndis
			stop_pidfile "$UDHCPC_PID"
			state=host-wait
			dhcp_iface=
		fi
		ensure_sshd
	else
		if [ "$state" != rndis ]; then
			log "no USB Ethernet adapter; selecting RNDIS fallback (USB mode: $mode)"
			stop_pidfile "$UDHCPC_PID"
			dhcp_iface=
			if configure_rndis_gadget; then
				start_rndis_dhcp
				state=rndis
			else
				state=rndis-retry
			fi
		elif ! alive "$UDHCPD_PID"; then
			start_rndis_dhcp
		fi
		ensure_sshd
	fi

	sleep "$POLL_SECONDS"
done
