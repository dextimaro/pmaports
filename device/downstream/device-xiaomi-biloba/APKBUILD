# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-xiaomi-biloba
pkgdesc="Xiaomi Redmi Note 8 (2021)"
pkgver=1
pkgrel=5
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck !strip"
depends="
	linux-xiaomi-biloba
	mkbootimg
	postmarketos-base
"
makedepends="devicepkg-dev"
install="
	$pkgname.post-install
	$pkgname.post-upgrade
"
source="
	deviceinfo
	kernel-cmdline.conf
	initfs-hook.sh
	biloba-usb-watchdog
	biloba-usb-watchdog.initd
	biloba-usb-watchdog.start
	biloba-pty.initd
	usbnet-stockcrc.ko
	cdc_ether-stockcrc.ko
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir"/biloba-usb-watchdog \
		"$pkgdir"/usr/sbin/biloba-usb-watchdog
	install -Dm755 "$srcdir"/biloba-usb-watchdog.initd \
		"$pkgdir"/etc/init.d/biloba-usb-watchdog
	install -Dm755 "$srcdir"/biloba-usb-watchdog.start \
		"$pkgdir"/etc/local.d/biloba-usb-watchdog.start
	install -Dm755 "$srcdir"/biloba-pty.initd \
		"$pkgdir"/etc/init.d/biloba-pty
	# Xiaomi's published source does not reproduce the ABI CRCs of the stock
	# kernel.  These two modules retain the stock 4.14.186 kernel and contain
	# CRCs extracted from that kernel's own __kcrctab.
	install -Dm644 "$srcdir"/usbnet-stockcrc.ko \
		"$pkgdir"/usr/lib/biloba-kernel-modules/usbnet.ko
	install -Dm644 "$srcdir"/cdc_ether-stockcrc.ko \
		"$pkgdir"/usr/lib/biloba-kernel-modules/cdc_ether.ko
}

