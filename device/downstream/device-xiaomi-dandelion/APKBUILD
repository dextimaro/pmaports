# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-xiaomi-dandelion
pkgdesc="Xiaomi Redmi 9A"
pkgver=0.1
pkgrel=22
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	doas
	linux-xiaomi-dandelion
	mkbootimg
	openssh-server
	postmarketos-base
"
makedepends="devicepkg-dev"
install="
	$pkgname.post-install
	$pkgname.post-upgrade
"
source="
	deviceinfo
	dandelion-usb-watchdog
	dandelion-usb-watchdog.initd
	dandelion-sshd.conf
	doas.conf
	initfs-hook.sh
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm755 "$srcdir"/dandelion-usb-watchdog \
		"$pkgdir"/usr/sbin/dandelion-usb-watchdog
	install -Dm755 "$srcdir"/dandelion-usb-watchdog.initd \
		"$pkgdir"/etc/init.d/dandelion-usb-watchdog
	install -Dm644 "$srcdir"/dandelion-sshd.conf \
		"$pkgdir"/etc/ssh/sshd_config.d/60-dandelion-usb.conf
	install -Dm644 "$srcdir"/doas.conf \
		"$pkgdir"/etc/doas.d/doas.conf
	chmod 755 "$pkgdir"/etc/doas.d
}

