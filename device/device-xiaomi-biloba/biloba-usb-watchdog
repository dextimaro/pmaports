#!/bin/sh

. /usr/share/initramfs/init_functions.sh
. /usr/share/misc/source_deviceinfo

logger -t biloba-usb-watchdog "USB RNDIS/SSH watchdog started"

module_dir=/usr/lib/biloba-kernel-modules
ethernet_dhcp_pid=/run/biloba-udhcpc-eth0.pid

load_ethernet_modules() {
	if ! grep -q '^usbnet ' /proc/modules; then
		insmod "$module_dir/usbnet.ko" 2>/dev/null || return 1
	fi
	if ! grep -q '^cdc_ether ' /proc/modules; then
		insmod "$module_dir/cdc_ether.ko" 2>/dev/null || return 1
	fi
	return 0
}

ethernet_iface() {
	if [ -e /sys/class/net/eth0 ]; then
		echo eth0
		return 0
	fi
	return 1
}

ethernet_dhcp_running() {
	[ -s "$ethernet_dhcp_pid" ] || return 1
	read -r pid < "$ethernet_dhcp_pid"
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start_ethernet_dhcp() {
	iface=$1
	ip link set "$iface" up 2>/dev/null || return 1
	ethernet_dhcp_running && return 0
	rm -f "$ethernet_dhcp_pid"
	logger -t biloba-usb-watchdog "Starting DHCP on $iface"
	start-stop-daemon --start --background --make-pidfile \
		--pidfile "$ethernet_dhcp_pid" --exec /usr/sbin/udhcpc -- \
		-f -S -i "$iface" -t 10 -T 2 -A 5 \
		-s /usr/share/udhcpc/default.script -x hostname:biloba
}

stop_ethernet_dhcp() {
	if ethernet_dhcp_running; then
		start-stop-daemon --stop --pidfile "$ethernet_dhcp_pid" \
			--retry TERM/3/KILL/1 >/dev/null 2>&1 || true
	fi
	rm -f "$ethernet_dhcp_pid"
}

management_iface() {
	# The initramfs creates usb0, but userspace may rename it to rndis0 while
	# preserving the configured management address.  Treat either name (or any
	# interface already carrying HOST_IP) as the live gadget; otherwise this
	# loop would unbind and rebind the UDC every two seconds.
	for iface in usb0 rndis0; do
		if ip link show "$iface" >/dev/null 2>&1; then
			echo "$iface"
			return 0
		fi
	done

	for netdev in /sys/class/net/*; do
		[ -e "$netdev" ] || continue
		iface=${netdev##*/}
		if ip addr show "$iface" 2>/dev/null | grep -q "inet $HOST_IP/"; then
			echo "$iface"
			return 0
		fi
	done

	return 1
}

while :; do
	load_ethernet_modules || \
		logger -t biloba-usb-watchdog "Could not load USB Ethernet modules"

	ethernet=$(ethernet_iface) || ethernet=
	if [ -n "$ethernet" ]; then
		start_ethernet_dhcp "$ethernet"
	else
		stop_ethernet_dhcp
		iface=$(management_iface) || iface=
		if [ -z "$iface" ]; then
			set -- /sys/class/udc/*
			if [ -e "$1" ]; then
				rm -f /tmp/_setup_usb_network
				setup_usb_network
			fi
			iface=$(management_iface) || iface=
		fi

		if [ -n "$iface" ]; then
			ip link set "$iface" up 2>/dev/null || true
			if ! ip addr show "$iface" | grep -q "inet $HOST_IP/"; then
				ifconfig "$iface" "$HOST_IP"
			fi
			start_unudhcpd
		fi
	fi

	if ! rc-service sshd status >/dev/null 2>&1; then
		rc-service sshd start
	fi

	sleep 2
done
