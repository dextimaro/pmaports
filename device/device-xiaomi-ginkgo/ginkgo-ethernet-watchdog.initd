#!/sbin/openrc-run

name="Redmi Note 8 USB Ethernet and SSH watchdog"
description="Configure a hotplugged USB Ethernet adapter through DHCP"
supervisor="supervise-daemon"
command="/usr/sbin/ginkgo-ethernet-watchdog"
respawn_delay=2

depend() {
	need localmount
	after modules udev-trigger
	use logger
}
