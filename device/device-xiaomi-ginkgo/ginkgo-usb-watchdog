#!/bin/sh

. /usr/share/initramfs/init_functions.sh
. /usr/share/misc/source_deviceinfo

logger -t ginkgo-usb-watchdog "USB NCM/SSH watchdog started"

while :; do
	if ! ip link show usb0 >/dev/null 2>&1; then
		set -- /sys/class/udc/*
		if [ -e "$1" ]; then
			# setup_usb_network only runs once by design. Clear its marker so
			# a previous race with the UDC does not suppress the next attempt.
			rm -f /tmp/_setup_usb_network
			setup_usb_network
		fi
	fi

	if ip link show usb0 >/dev/null 2>&1; then
		ip link set usb0 up 2>/dev/null || true
		if ! ip addr show usb0 | grep -q "$HOST_IP"; then
			ifconfig usb0 "$HOST_IP"
		fi
		start_unudhcpd
	fi

	if ! rc-service sshd status >/dev/null 2>&1; then
		rc-service sshd start
	fi

	sleep 2
done
