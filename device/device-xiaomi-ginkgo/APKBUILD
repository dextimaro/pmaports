# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-xiaomi-ginkgo
pkgdesc="Xiaomi Redmi Note 8"
pkgver=1
pkgrel=6
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	mkbootimg
	postmarketos-base
"
makedepends="devicepkg-dev"
install="
	$pkgname.post-install
	$pkgname.post-upgrade
"
source="
	deviceinfo
	ginkgo-ethernet-watchdog
	ginkgo-ethernet-watchdog.initd
	ginkgo-usb-watchdog
	ginkgo-usb-watchdog.initd
	initfs-hook.sh
	kernel-cmdline.conf
	modules-initfs
"
subpackages="$pkgname-kernel-mainline:kernel_mainline"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm755 "$srcdir"/ginkgo-usb-watchdog \
		"$pkgdir"/usr/sbin/ginkgo-usb-watchdog
	install -Dm755 "$srcdir"/ginkgo-usb-watchdog.initd \
		"$pkgdir"/etc/init.d/ginkgo-usb-watchdog
	install -Dm755 "$srcdir"/ginkgo-ethernet-watchdog \
		"$pkgdir"/usr/sbin/ginkgo-ethernet-watchdog
	install -Dm755 "$srcdir"/ginkgo-ethernet-watchdog.initd \
		"$pkgdir"/etc/init.d/ginkgo-ethernet-watchdog
}

kernel_mainline() {
	pkgdesc="Upstream development kernel"
	depends="linux-xiaomi-ginkgo"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

